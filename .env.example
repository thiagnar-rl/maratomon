# Copie este arquivo para .env.local e preencha.

# Endereço público do site (usado no sitemap e nos links de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com

# Supabase (opcional): login e progresso na nuvem. Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# YouTube Data API v3 (só para o script npm run sync:youtube; não vai para o navegador)
YOUTUBE_API_KEY=
